<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="Shared Frame" android:textColor="#171717" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="36dp" android:gravity="center" android:text="One reusable transition, two Android UI stacks" android:textColor="#666666" android:textSize="16sp" />
    <Button android:id="@+id/open_views_demo" android:layout_width="match_parent" android:layout_height="56dp" android:text="Views / XML demo" />
    <Button android:id="@+id/open_compose_demo" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="Jetpack Compose demo" />
</LinearLayout>
